{
  "name": "@smthrs/memory",
  "version": "0.23.0",
  "description": "Persistent and semantic memory services for Smithers",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js",
      "default": "./src/index.js"
    },
    "./store": {
      "types": "./src/index.d.ts",
      "import": "./src/store/index.js",
      "default": "./src/store/index.js"
    },
    "./metrics": {
      "types": "./src/index.d.ts",
      "import": "./src/metrics.js",
      "default": "./src/metrics.js"
    },
    "./schema": {
      "types": "./src/index.d.ts",
      "import": "./src/schema.js",
      "default": "./src/schema.js"
    },
    "./*": {
      "types": "./src/index.d.ts",
      "import": "./src/*.js",
      "default": "./src/*.js"
    }
  },
  "files": [
    "src/"
  ],
  "scripts": {
    "build": "tsup --dts-only",
    "test": "bun test tests",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@smthrs/db": "^0.33.0",
    "@smthrs/errors": "^0.33.0",
    "@smthrs/graph": "^0.33.0",
    "@smthrs/observability": "^0.33.0",
    "@smthrs/scheduler": "^0.33.0",
    "drizzle-orm": "^0.45.2",
    "effect": "^3.21.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "~5.9.3"
  }
}
