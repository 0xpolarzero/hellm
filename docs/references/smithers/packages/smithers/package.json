{
  "name": "smthrs",
  "version": "0.23.0",
  "description": "Public Smithers facade for durable coding-agent workflows and Gateway operation",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js",
      "default": "./src/index.js"
    },
    "./tools": {
      "types": "./src/tools.d.ts",
      "import": "./src/tools.js",
      "default": "./src/tools.js"
    },
    "./gateway-client": {
      "types": "./src/gateway-client.d.ts",
      "import": "./src/gateway-client.js",
      "default": "./src/gateway-client.js"
    },
    "./gateway-react": {
      "types": "./src/gateway-react.d.ts",
      "import": "./src/gateway-react.js",
      "default": "./src/gateway-react.js"
    },
    "./sandbox": {
      "types": "./src/sandbox.d.ts",
      "import": "./src/sandbox.js",
      "default": "./src/sandbox.js"
    },
    "./control-plane": {
      "types": "./src/control-plane.d.ts",
      "import": "./src/control-plane.js",
      "default": "./src/control-plane.js"
    },
    "./*": {
      "types": "./src/index.d.ts",
      "import": "./src/*.js",
      "default": "./src/*.js"
    },
    "./jsx-dev-runtime": {
      "types": "./src/index.d.ts",
      "import": "./src/jsx-runtime.js",
      "default": "./src/jsx-runtime.js"
    }
  },
  "files": [
    "src/"
  ],
  "bin": {
    "smithers": "./src/bin/smithers.js"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "tsup --dts-only"
  },
  "dependencies": {
    "@smthrs/agents": "^0.33.0",
    "@smthrs/cli": "^0.33.0",
    "@smthrs/components": "^0.33.0",
    "@smthrs/control-plane": "^0.33.0",
    "@smthrs/db": "^0.33.0",
    "@smthrs/driver": "^0.33.0",
    "@smthrs/engine": "^0.33.0",
    "@smthrs/errors": "^0.33.0",
    "@smthrs/gateway-client": "^0.33.0",
    "@smthrs/gateway-react": "^0.33.0",
    "@smthrs/graph": "^0.33.0",
    "@smthrs/memory": "^0.33.0",
    "@smthrs/observability": "^0.33.0",
    "@smthrs/openapi": "^0.33.0",
    "@smthrs/react-reconciler": "^0.33.0",
    "@smthrs/sandbox": "^0.33.0",
    "@smthrs/scheduler": "^0.33.0",
    "@smthrs/scorers": "^0.33.0",
    "@smthrs/server": "^0.33.0",
    "@smthrs/time-travel": "^0.33.0",
    "@smthrs/tool-context": "^0.33.0",
    "@smthrs/vcs": "^0.33.0",
    "@mdx-js/esbuild": "^3.1.1",
    "ai": "^6.0.168",
    "diff": "^9.0.0",
    "drizzle-orm": "^0.45.2",
    "effect": "^3.21.1",
    "incur": "^0.4.1",
    "react": "^19.2.5",
    "zod": "^4.3.6"
  },
  "optionalDependencies": {
    "@electric-sql/pglite": "0.5.1",
    "@electric-sql/pglite-socket": "0.2.1",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "~5.9.3"
  }
}
