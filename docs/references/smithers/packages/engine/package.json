{
  "name": "@smthrs/engine",
  "version": "0.23.0",
  "description": "Concrete Smithers workflow execution engine",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js",
      "default": "./src/index.js"
    },
    "./*": {
      "types": "./src/index.d.ts",
      "import": "./src/*.js",
      "default": "./src/*.js"
    }
  },
  "files": [
    "src/"
  ],
  "scripts": {
    "build": "tsup --dts-only",
    "test": "bun test --timeout=60000 --max-concurrency=1 tests",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@effect/cluster": "^0.58.0",
    "@effect/experimental": "^0.60.0",
    "@effect/platform-bun": "^0.89.0",
    "@effect/rpc": "^0.75.0",
    "@effect/sql": "^0.51.0",
    "@effect/sql-sqlite-bun": "^0.52.0",
    "@effect/workflow": "^0.18.0",
    "@smthrs/agents": "^0.33.0",
    "@smthrs/components": "^0.33.0",
    "@smthrs/db": "^0.33.0",
    "@smthrs/driver": "^0.33.0",
    "@smthrs/errors": "^0.33.0",
    "@smthrs/graph": "^0.33.0",
    "@smthrs/observability": "^0.33.0",
    "@smthrs/react-reconciler": "^0.33.0",
    "@smthrs/sandbox": "^0.33.0",
    "@smthrs/scheduler": "^0.33.0",
    "@smthrs/scorers": "^0.33.0",
    "@smthrs/time-travel": "^0.33.0",
    "@smthrs/tool-context": "^0.33.0",
    "@smthrs/vcs": "^0.33.0",
    "diff": "^9.0.0",
    "drizzle-orm": "^0.45.2",
    "effect": "^3.21.1",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "zod": "^4.3.6"
  },
  "optionalDependencies": {
    "@electric-sql/pglite": "0.5.1",
    "@electric-sql/pglite-socket": "0.2.1",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "~5.9.3"
  }
}
