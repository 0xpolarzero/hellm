{
  "name": "@smthrs/components",
  "version": "0.23.0",
  "description": "React components for Smithers workflows",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js",
      "default": "./src/index.js"
    },
    "./*": {
      "types": "./src/index.d.ts",
      "import": "./src/*.js",
      "default": "./src/*.js"
    }
  },
  "files": [
    "src/"
  ],
  "scripts": {
    "test": "bun test tests",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "tsup --dts-only"
  },
  "dependencies": {
    "@smthrs/agents": "^0.33.0",
    "@smthrs/db": "^0.33.0",
    "@smthrs/driver": "^0.33.0",
    "@smthrs/errors": "^0.33.0",
    "@smthrs/graph": "^0.33.0",
    "@smthrs/memory": "^0.33.0",
    "@smthrs/observability": "^0.33.0",
    "@smthrs/react-reconciler": "^0.33.0",
    "@smthrs/scheduler": "^0.33.0",
    "bippy": "^0.5.39",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@tanstack/react-query": "^5.99.1",
    "@types/bun": "latest",
    "drizzle-orm": "^0.45.2",
    "effect": "^3.21.1",
    "typescript": "~5.9.3"
  }
}
