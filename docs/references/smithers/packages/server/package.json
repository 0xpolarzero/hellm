{
  "name": "@smthrs/server",
  "version": "0.23.0",
  "description": "HTTP, WebSocket, gateway, cron, webhook, and metrics servers for Smithers",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js",
      "default": "./src/index.js"
    },
    "./*": {
      "types": "./src/index.d.ts",
      "import": "./src/*.js",
      "default": "./src/*.js"
    }
  },
  "files": [
    "src/"
  ],
  "scripts": {
    "test": "bun test tests",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "rm -f src/index.d.ts && node ../../node_modules/tsup/dist/cli-default.js --dts-only"
  },
  "dependencies": {
    "@effect/workflow": "^0.18.0",
    "@smthrs/components": "^0.33.0",
    "@smthrs/db": "^0.33.0",
    "@smthrs/devtools": "^0.33.0",
    "@smthrs/driver": "^0.33.0",
    "@smthrs/engine": "^0.33.0",
    "@smthrs/errors": "^0.33.0",
    "@smthrs/gateway": "^0.33.0",
    "@smthrs/observability": "^0.33.0",
    "@smthrs/protocol": "^0.33.0",
    "@smthrs/scheduler": "^0.33.0",
    "@smthrs/time-travel": "^0.33.0",
    "cron-parser": "^5.5.0",
    "drizzle-orm": "^0.45.2",
    "effect": "^3.21.1",
    "hono": "^4.12.14",
    "ws": "^8.20.0"
  },
  "devDependencies": {
    "@smthrs/graph": "^0.33.0",
    "@types/bun": "latest",
    "react": "^19.2.5",
    "typescript": "~5.9.3",
    "zod": "^4.3.6"
  }
}
