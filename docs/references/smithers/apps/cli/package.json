{
  "name": "@smthrs/cli",
  "version": "0.23.0",
  "description": "Smithers command-line interface, MCP server, and local workflow tools",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./src/index.js",
      "default": "./src/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "import": "./src/*.js",
      "default": "./src/*.js"
    }
  },
  "files": [
    "src/",
    "dist/",
    "docs/"
  ],
  "scripts": {
    "test": "bun test --timeout=120000 --max-concurrency=1 tests",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "tsup --dts-only"
  },
  "dependencies": {
    "@mdx-js/esbuild": "^3.1.1",
    "@effect/workflow": "^0.18.0",
    "@clack/prompts": "^0.10.1",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@smthrs/accounts": "^0.33.0",
    "@smthrs/agents": "^0.33.0",
    "@smthrs/usage": "^0.33.0",
    "@smthrs/components": "^0.33.0",
    "@smthrs/db": "^0.33.0",
    "@smthrs/devtools": "^0.33.0",
    "@smthrs/driver": "^0.33.0",
    "@smthrs/engine": "^0.33.0",
    "@smthrs/errors": "^0.33.0",
    "@smthrs/memory": "^0.33.0",
    "@smthrs/observability": "^0.33.0",
    "@smthrs/openapi": "^0.33.0",
    "@smthrs/protocol": "^0.33.0",
    "@smthrs/scheduler": "^0.33.0",
    "@smthrs/server": "^0.33.0",
    "@smthrs/time-travel": "^0.33.0",
    "@smthrs/vcs": "^0.33.0",
    "smthrs": "^0.33.0",
    "cron-parser": "^5.5.0",
    "drizzle-orm": "^0.45.2",
    "effect": "^3.21.1",
    "incur": "^0.4.1",
    "picocolors": "^1.1.1",
    "react": "^19.2.5",
    "yaml": "^2.8.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "~5.9.3"
  }
}
