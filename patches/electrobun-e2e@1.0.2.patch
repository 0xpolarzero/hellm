+export function resolveOrbStackMachineArch(
+  configuredArch: string | undefined,
+  hostArch: string = process.arch,
+): OrbStackMachineArch {
+  const candidate = configuredArch || hostArch;
+  switch (candidate.toLowerCase()) {
+    case "arm64":
+    case "aarch64":
+      return "arm64";
+    case "x64":
+    case "x86_64":
+    case "amd64":
+      return "amd64";
+    default:
+      throw new Error(
+        `Unsupported OrbStack machine architecture "${candidate}". Expected "amd64" or "arm64".`,
+      );
+  }
+}
