+export function assertOrbStackMachineArchMatches(
+  machineName: string,
+  expectedArch: OrbStackMachineArch,
+  actualArch: OrbStackMachineArch,
+): void {
+  if (actualArch === expectedArch) return;
+  throw new Error(
+    `OrbStack machine "${machineName}" has architecture "${actualArch}", but this e2e config requires "${expectedArch}". ` +
+      `Use a different machineName or explicitly delete and recreate this machine before running setup again; ` +
+      `electrobun-e2e will not replace it automatically.`,
+  );
+}
+
+function assertOrbStackMachineArch(
+  machineName: string,
+  expectedArch: OrbStackMachineArch,
+): void {
+  const result = spawnSync("orb", ["-m", machineName, "uname", "-m"], {
+    encoding: "utf8",
+  });
+  if (result.status !== 0) {
+    const detail = [result.stdout, result.stderr].filter(Boolean).join("\n").trim();
+    throw new Error(
+      `Could not determine the architecture of OrbStack machine "${machineName}"${
+        detail ? `: ${detail}` : "."
+      }`,
+    );
+  }
+  assertOrbStackMachineArchMatches(
+    machineName,
+    expectedArch,
+    normalizeOrbStackGuestArch(result.stdout),
+  );
+}
