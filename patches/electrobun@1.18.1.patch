+async function ensureCoreDependencies() {
+  const corePlatform = platform === 'darwin' ? 'macos' : platform;
+  const coreDir = join(electrobunDir, `dist-${corePlatform}-${arch}`);
+  const requiredFiles = [
+    'bun' + binExt,
+    'bsdiff' + binExt,
+    'bspatch' + binExt,
+    'zig-zstd' + binExt,
+    ...(platform === 'darwin'
+      ? ['launcher', 'libNativeWrapper.dylib']
+      : platform === 'win'
+        ? ['libNativeWrapper.dll']
+        : ['libNativeWrapper.so']),
+  ];
+  const missingFiles = requiredFiles.filter((file) => !existsSync(join(coreDir, file)));
+  if (missingFiles.length === 0) {
+    return;
+  }
+
+  const packageJson = require(join(electrobunDir, 'package.json'));
+  const version = packageJson.version;
+  const tarballUrl = `https://github.com/blackboardsh/electrobun/releases/download/v${version}/electrobun-core-${platform}-${arch}.tar.gz`;
+  mkdirSync(cacheDir, { recursive: true });
+  const stagingRoot = mkdtempSync(join(cacheDir, `core-${platform}-${arch}-`));
+  const stagingCoreDir = join(stagingRoot, 'core');
+  const tarballPath = join(stagingRoot, 'core.tar.gz');
+  const backupDir = join(stagingRoot, 'previous-core');
+
+  try {
+    console.log(`Downloading electrobun core for ${platform}-${arch}...`);
+    await downloadFile(tarballUrl, tarballPath);
+    mkdirSync(stagingCoreDir, { recursive: true });
+    execSync(`${getTarCommand()} -xzf "${tarballPath}"`, {
+      cwd: stagingCoreDir,
+      stdio: 'pipe',
+    });
+
+    const stillMissing = requiredFiles.filter(
+      (file) => !existsSync(join(stagingCoreDir, file)),
+    );
+    if (stillMissing.length > 0) {
+      throw new Error(
+        `Electrobun core archive is incomplete for ${platform}-${arch}: ${stillMissing.join(', ')}`,
+      );
+    }
+
+    if (existsSync(coreDir)) {
+      renameSync(coreDir, backupDir);
+    }
+    try {
+      renameSync(stagingCoreDir, coreDir);
+    } catch (error) {
+      if (existsSync(backupDir)) {
+        renameSync(backupDir, coreDir);
+      }
+      throw error;
+    }
+    rmSync(backupDir, { force: true, recursive: true });
+    console.log('electrobun core downloaded successfully!');
+  } finally {
+    rmSync(stagingRoot, { force: true, recursive: true });
+  }
+}
+
+function readBunIdentity(binaryPath) {
+  try {
+    return {
+      revision: execFileSync(binaryPath, ['--revision'], { encoding: 'utf8' }).trim(),
+      version: execFileSync(binaryPath, ['--version'], { encoding: 'utf8' }).trim(),
+    };
+  } catch {
+    return null;
+  }
+}
+
+function isFixedCanaryBun(binaryPath) {
+  const identity = readBunIdentity(binaryPath);
+  if (!identity || !identity.revision.includes('-canary.')) {
+    return false;
+  }
+  const match = /^(\d+)\.(\d+)\.(\d+)/.exec(identity.version);
+  if (!match) return false;
+  const version = match.slice(1).map(Number);
+  return version[0] > 1 || (version[0] === 1 && version[1] >= 4);
+}
+
+function resolveConsumerElectrobunDir() {
+  let directory = process.cwd();
+  while (directory !== dirname(directory)) {
+    const candidate = join(directory, 'node_modules', 'electrobun');
+    if (existsSync(join(candidate, 'package.json'))) {
+      return candidate;
+    }
+    directory = dirname(directory);
+  }
+  return electrobunDir;
+}
+
+async function ensureCanaryBunOverride() {
+  const targetOS = platform === 'darwin' ? 'macos' : platform;
+  const targetArch = arch;
+  mkdirSync(cacheDir, { recursive: true });
+  const overrideDir = join(dirname(resolveConsumerElectrobunDir()), '.electrobun-cache', 'bun-override', `${targetOS}-${targetArch}`);
+  const overrideBinary = join(overrideDir, `bun${binExt}`);
+  const versionFile = join(overrideDir, '.bun-version');
+  if (existsSync(overrideBinary) && isFixedCanaryBun(overrideBinary)) {
+    writeFileSync(versionFile, 'canary');
+    return;
+  }
+
+  const stagingRoot = mkdtempSync(join(cacheDir, `bun-canary-${targetOS}-${targetArch}-`));
+  const stagedOverride = join(stagingRoot, 'override');
+  const stagedBinary = join(stagedOverride, `bun${binExt}`);
+  try {
+    mkdirSync(stagedOverride, { recursive: true });
+    if (targetOS === (process.platform === 'darwin' ? 'macos' : platform) && targetArch === getArch() && isFixedCanaryBun(process.execPath)) {
+      copyFileSync(process.execPath, stagedBinary);
+    } else {
+      const asset =
+        targetOS === 'macos'
