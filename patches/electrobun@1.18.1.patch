+      const zipPath = join(stagingRoot, 'bun.zip');
+      await downloadFile(`https://github.com/oven-sh/bun/releases/download/canary/${asset}.zip`, zipPath);
+      if (targetOS === 'win') {
+        execFileSync('powershell', [
+          '-NoProfile',
+          '-Command',
+          'Expand-Archive -LiteralPath $args[0] -DestinationPath $args[1] -Force',
+          zipPath,
+          stagingRoot,
+        ]);
+      } else {
+        execFileSync('unzip', ['-q', '-o', zipPath, '-d', stagingRoot]);
+      }
+      copyFileSync(join(stagingRoot, asset, `bun${binExt}`), stagedBinary);
+    }
+    if (targetOS !== 'win') chmodSync(stagedBinary, '755');
+    if (!isFixedCanaryBun(stagedBinary)) {
+      throw new Error('Downloaded Bun canary does not satisfy the required >=1.4.0 runtime contract.');
+    }
+    writeFileSync(join(stagedOverride, '.bun-version'), 'canary');
+    rmSync(overrideDir, { force: true, recursive: true });
+    mkdirSync(dirname(overrideDir), { recursive: true });
+    renameSync(stagedOverride, overrideDir);
+    const identity = readBunIdentity(overrideBinary);
+    console.log(`Prepared Electrobun Bun runtime ${identity.version} (${identity.revision}).`);
+  } finally {
+    rmSync(stagingRoot, { force: true, recursive: true });
+  }
+}
