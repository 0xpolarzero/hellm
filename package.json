{
  "name": "svvy",
  "version": "0.0.1",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "generate:api": "bun scripts/generate-api-declarations.ts && bun x oxfmt generated/*.generated.ts",
    "generate:core-index": "bun scripts/generate-core-public-symbol-index.ts",
    "check:core-index": "bun scripts/generate-core-public-symbol-index.ts --check",
    "start": "bun run generate:api && vite build && electrobun dev",
    "dev": "bun run generate:api && bun scripts/dev.ts",
    "dev:clean": "bun run clean:session-state && bun run dev",
    "inspect:app": "bun scripts/inspect-app.ts",
    "clean:session-state": "bun scripts/clean-session-state.ts",
    "build": "bun run generate:api && vite build && SVVY_SKIP_DMG=1 electrobun build --env=stable",
    "build:check": "bun run generate:api && vite build && SVVY_SKIP_DMG=1 electrobun build --env=stable",
    "build:dmg": "bun run generate:api && vite build && SVVY_CREATE_DMG=1 electrobun build --env=stable",
    "build:dev": "bun run generate:api && vite build && electrobun build --env=dev",
    "run": "electrobun run",
    "workflow:implement-feature": "bun workflows/scripts/run-implement-feature.ts",
    "check": "bun run check:core-index && bun run check:e2e-coverage:complete && bun run typecheck && bun run test:unit && bun run test:effect && bun run lint:check && bun run format:check && bun run build:check",
    "check:e2e-coverage": "bun scripts/check-e2e-coverage.ts",
    "check:e2e-coverage:complete": "bun scripts/check-e2e-coverage.ts --require-complete-shipped",
    "test": "bun run test:unit && bun run test:e2e",
    "test:unit": "bun run generate:api && bun test $(rg --files ./src ./packages -g '*.test.ts' -g '*.spec.ts' -g '*_test.ts' -g '*_spec.ts' -g '!*.effect.test.ts')",
    "test:effect": "vitest run --root . $(rg --files packages -g '*.effect.test.ts')",
    "setup:e2e": "electrobun-e2e setup --config ./electrobun-e2e.config.ts",
    "test:e2e": "bun scripts/run-e2e.ts",
    "test:e2e:startup-soak": "env SVVY_E2E_STARTUP_SOAK_LAUNCHES=25 bun run test:e2e -- e2e/svvy-smoke.test.ts",
    "typecheck": "bun run generate:api && bun run typecheck:root && bun run typecheck:packages && bun run typecheck:workflows",
    "typecheck:root": "tsgo -p tsconfig.json --noEmit",
    "typecheck:packages": "tsgo -p packages/core/tsconfig.json --noEmit && tsgo -p packages/state/tsconfig.json --noEmit && tsgo -p packages/pi-adapter/tsconfig.json --noEmit && tsgo -p packages/sandbox/tsconfig.json --noEmit && tsgo -p packages/extensions/tsconfig.json --noEmit && tsgo -p packages/runtime/tsconfig.json --noEmit && tsgo -p packages/desktop/tsconfig.json --noEmit",
    "typecheck:workflows": "bun run --cwd workflows typecheck",
    "lint": "oxlint . --disable-nested-config --import-plugin --node-plugin --deny-warnings --fix --fix-suggestions",
    "lint:check": "oxlint . --disable-nested-config --import-plugin --node-plugin --deny-warnings",
    "format": "oxfmt $(rg --files -g '*.ts' -g '*.tsx' -g '*.svelte' -g '*.toml' -g '!docs/references/**')",
    "format:check": "oxfmt --check $(rg --files -g '*.ts' -g '*.tsx' -g '*.svelte' -g '*.toml' -g '!docs/references/**')"
  },
  "dependencies": {
    "@effect/platform-bun": "4.0.0-beta.84",
    "@fontsource-variable/familjen-grotesk": "^5.2.8",
    "@lucide/svelte": "^1.8.0",
    "@mariozechner/pi-agent-core": "0.73.1",
    "@mariozechner/pi-ai": "0.73.1",
    "@mariozechner/pi-coding-agent": "0.73.1",
    "@mdit/plugin-katex": "^0.25.2",
    "@svvy/core": "workspace:*",
    "@svvy/desktop": "workspace:*",
    "@svvy/extensions": "workspace:*",
    "@svvy/pi-adapter": "workspace:*",
    "@svvy/runtime": "workspace:*",
    "@svvy/sandbox": "workspace:*",
    "@svvy/state": "workspace:*",
    "@tanstack/svelte-form": "^1.32.0",
    "@tanstack/svelte-hotkeys": "^0.10.0",
    "@tanstack/svelte-virtual": "^3.13.26",
    "cmdk-sv": "^0.0.19",
    "dockview-core": "^6.1.1",
    "effect": "4.0.0-beta.84",
    "electrobun": "1.18.1",
    "incur": "github:wevm/incur#db1f8c0a62b6de45ab361ffead522b4323d5bc77",
    "katex": "^0.16.45",
    "markdown-it": "^14.1.1",
    "markdown-it-abbr": "^2.0.0",
    "markdown-it-deflist": "^3.0.0",
    "markdown-it-footnote": "^4.0.0",
    "markdown-it-task-lists": "^2.1.1",
    "mermaid": "^11.15.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "shiki": "^4.0.2",
    "svelte": "^5.55.1",
    "tokenx": "^1.3.0",
    "typebox": "^1.1.24",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@effect/vitest": "4.0.0-beta.84",
    "@sveltejs/vite-plugin-svelte": "^7.0.0",
    "@tailwindcss/vite": "^4.0.0",
    "@types/bun": "^1.3.11",
    "@types/markdown-it": "^14.1.2",
    "@types/markdown-it-footnote": "^3.0.4",
    "@types/three": "^0.184.0",
    "@typescript/native-preview": "beta",
    "electrobun-browser-tools": "1.0.1",
    "electrobun-e2e": "1.0.2",
    "oxfmt": "0.44.0",
    "oxlint": "1.59.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^6.0.2",
    "vite": "^8.0.3",
    "vitest": "4.1.4"
  },
  "engines": {
    "bun": ">=1.3.14"
  },
  "packageManager": "bun@1.3.14",
  "patchedDependencies": {
    "@mariozechner/pi-coding-agent@0.73.1": "patches/@mariozechner%2Fpi-coding-agent@0.73.1.patch",
    "electrobun-browser-tools@1.0.1": "patches/electrobun-browser-tools@1.0.1.patch",
    "electrobun-e2e@1.0.2": "patches/electrobun-e2e@1.0.2.patch",
    "electrobun@1.18.1": "patches/electrobun@1.18.1.patch"
  }
}
